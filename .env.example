# Database - Supabase PostgreSQL
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_SERVICE_KEY="your_supabase_service_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# OpenAI (fallback/primary)
OPENAI_API_KEY="your_openai_api_key_here"
# Optional rotation
# OPENAI_API_KEY_1="your_openai_api_key_1"
# OPENAI_API_KEY_2="your_openai_api_key_2"
# Preferred model (e.g., gpt-4.1-mini, gpt-4.1, o3-mini)
OPENAI_MODEL="gpt-4.1-mini"

# Google Gemini AI
# Get API keys from https://aistudio.google.com/apikey
# IMPORTANT: Add HTTP referrer restrictions to protect your keys
GEMINI_API_KEY_1="your_gemini_api_key_1"
GEMINI_API_KEY_2="your_gemini_api_key_2"
GEMINI_API_KEY_3="your_gemini_api_key_3"
GEMINI_API_KEY_4="your_gemini_api_key_4"

# Rate Limiting
IMAGE_RATE_LIMIT_PER_DAY=999

# Admin Credentials
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="your_secure_password_here"
ADMIN_PASSWORD_HASH="$2b$10$your_bcrypt_hash_here"
ADMIN_SESSION_COOKIE_DOMAIN=".trolyphaply.vn"

# App Config
NEXT_PUBLIC_APP_URL="http://localhost:3456"
PORT=3456
NEXT_PUBLIC_APP_NAME="Trợ Lý Pháp Lý"
NODE_ENV=development

# Feature Flags
ENABLE_DEBUG=true
ENABLE_ANALYTICS=false

# Admin customers security (extra gate)
ADMIN_CUSTOMERS_SESSION_SECRET="your_random_session_secret"
ADMIN_CUSTOMERS_TOTP_SECRET="BASE32_TOTP_SECRET"
ADMIN_CUSTOMERS_PIN="set_pin_here"
# ADMIN_CUSTOMERS_PIN_HASH="sha256_hex_pin_hash"
ADMIN_CUSTOMERS_ALLOWED_IPS="14.248.90.137"
ADMIN_CUSTOMERS_ALLOWED_HOSTS="admin.trolyphaply.vn"
ADMIN_CUSTOMERS_2FA_TTL_SECONDS=28800
ADMIN_CUSTOMERS_PHONE_KEY="base64_or_hex_32byte_key"
ADMIN_CUSTOMERS_PHONE_HMAC_KEY="base64_or_hex_32byte_key"
NEXT_PUBLIC_ADMIN_CUSTOMERS_BASE_URL="https://admin.trolyphaply.vn"
