// Prisma schema for TroLyPhapLy
// Note: Prisma 7 - datasource moved to runtime config
// Schema chỉ dùng để generate types, không dùng cho migrations
generator client {
  provider = "prisma-client-js"
}

// Database connection configured at runtime via Supabase client
// This schema is for type generation only

model AdminUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("admin_users")
}

model LegalDocument {
  id            String   @id @default(uuid())
  title         String
  docNumber     String?  @map("doc_number")
  type          String
  authority     String
  issueDate     DateTime @map("issue_date")
  effectiveDate DateTime @map("effective_date")
  summary       String?  @db.Text
  content       Json
  tags          String[]
  category      String
  status        String   @default("active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  @@map("legal_documents")
}

model Procedure {
  id        String   @id @default(uuid())
  title     String
  authority String
  timeEst   String   @map("time_est")
  category  String
  steps     Json
  documents Json
  fees      String?
  notes     String?  @db.Text
  tags      String[]
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("procedures")
}

model Prompt {
  id        String   @id @default(uuid())
  title     String
  body      String   @db.Text
  category  String
  tags      String[]
  isPublic  Boolean  @default(true) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("prompts")
}

model StyleGuide {
  id              String              @id @default(uuid())
  name            String
  description     String              @db.Text
  characteristics String[]
  tone            String
  language        String              @default("vi")
  isDefault       Boolean             @default(false) @map("is_default")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  examples        StyleGuideExample[]
  @@map("style_guides")
}

model StyleGuideExample {
  id           String     @id @default(uuid())
  styleGuideId String     @map("style_guide_id")
  question     String     @db.Text
  answer       String     @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")
  styleGuide   StyleGuide @relation(fields: [styleGuideId], references: [id], onDelete: Cascade)
  @@map("style_guide_examples")
}

model App {
  id             String   @id @default(uuid())
  slug           String   @unique
  name           String
  description    String?
  category       String   @default("other")
  status         String   @default("draft")
  type           String
  inputSchema    Json     @map("input_schema")
  promptTemplate String   @db.Text @map("prompt_template")
  outputSchema   Json?    @map("output_schema")
  renderConfig   Json?    @map("render_config")
  shareConfig    Json?    @map("share_config")
  limits         Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  results        Result[]
  statsDaily     AppStatsDaily[]
  events         AppEvent[]
  @@map("apps")
}

model Result {
  id         String   @id @default(uuid())
  appId      String   @map("app_id")
  inputData  Json     @map("input_data")
  outputData Json?    @map("output_data")
  imageUrl   String?  @map("image_url")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  app        App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  events     AppEvent[]
  @@map("results")
}

model AppStatsDaily {
  appId           String   @map("app_id")
  date            DateTime @db.Date
  views           Int      @default(0)
  submits         Int      @default(0)
  shares          Int      @default(0)
  affiliateClicks Int      @default(0) @map("affiliate_clicks")
  app             App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  @@id([appId, date])
  @@map("app_stats_daily")
}

model AppEvent {
  id        BigInt   @id @default(autoincrement())
  appId     String   @map("app_id")
  eventType String   @map("event_type")
  resultId  String?  @map("result_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  result    Result?  @relation(fields: [resultId], references: [id], onDelete: SetNull)
  @@map("app_events")
}

// ============================================
// FACEBOOK PAGE AUTOMATION MODELS
// ============================================

model FacebookConnection {
  id                String   @id @default(uuid())
  userAccessToken   String   @db.Text @map("user_access_token")
  tokenExpiresAt    DateTime? @map("token_expires_at")
  scopes            String[] @default([])
  status            String   @default("active") // active, expired, revoked
  lastVerifiedAt    DateTime? @map("last_verified_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  @@map("facebook_connection")
}

model FacebookPage {
  id                String   @id @default(uuid())
  pageId            String   @unique @map("page_id")
  pageName          String   @map("page_name")
  pageAccessToken   String   @db.Text @map("page_access_token")
  category          String?
  followerCount     Int?     @map("follower_count")
  automationEnabled Boolean  @default(true) @map("automation_enabled")
  status            String   @default("active") // active, inactive
  lastSyncAt        DateTime? @map("last_sync_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  replyRules        AutoReplyRule[]
  messageRules      AutoMessageRule[]
  stats             PageStats[]
  @@map("facebook_pages")
}

model AutoReplyRule {
  id              String   @id @default(uuid())
  name            String
  pageId          String   @map("page_id")
  postId          String?  @map("post_id") // null = áp dụng cho tất cả posts
  triggerType     String   @default("all") @map("trigger_type") // all, keyword
  keywords        String[] @default([]) // trigger keywords (OR logic)
  excludeKeywords String[] @default([]) @map("exclude_keywords") // blacklist
  replyTemplates  String[] @map("reply_templates") // Array of spin templates
  priority        Int      @default(0) // Higher = execute first
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  page            FacebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  @@index([pageId, postId])
  @@map("auto_reply_rules")
}

model AutoMessageRule {
  id                String   @id @default(uuid())
  name              String
  pageId            String   @map("page_id")
  triggerOn         String[] @map("trigger_on") // ["comment", "reaction"]
  messageTemplate   String   @db.Text @map("message_template")
  cooldownMinutes   Int      @default(1440) @map("cooldown_minutes") // 24h default
  enabled           Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  page              FacebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  @@map("auto_message_rules")
}

model FacebookEvent {
  id          String   @id @default(uuid())
  eventType   String   @map("event_type") // comment, reaction, post
  pageId      String   @map("page_id")
  postId      String?  @map("post_id")
  commentId   String?  @map("comment_id")
  userId      String?  @map("user_id") // Facebook user ID
  dedupeKey   String   @unique @map("dedupe_key") // For idempotency
  payload     Json     // Full webhook payload
  status      String   @default("received") // received, processed, failed
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  @@index([pageId, createdAt])
  @@index([dedupeKey])
  @@map("facebook_events")
}

model AutomationQueue {
  id          String   @id @default(uuid())
  jobType     String   @map("job_type") // reply_comment, send_message
  pageId      String   @map("page_id")
  targetId    String   @map("target_id") // comment_id or user_id
  payload     Json     // Job data
  scheduledAt DateTime @map("scheduled_at") // Execute after this time
  attempts    Int      @default(0)
  maxAttempts Int      @default(3) @map("max_attempts")
  status      String   @default("pending") // pending, processing, completed, failed
  error       String?  @db.Text
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  @@index([status, scheduledAt])
  @@index([pageId])
  @@map("automation_queue")
}

model AutomationLog {
  id          String   @id @default(uuid())
  actionType  String   @map("action_type") // reply_sent, message_sent, rule_matched
  pageId      String   @map("page_id")
  postId      String?  @map("post_id")
  targetId    String?  @map("target_id") // comment_id, user_id
  ruleId      String?  @map("rule_id")
  contentSent String?  @db.Text @map("content_sent")
  status      String   // success, failed, skipped
  metadata    Json?    // Additional context
  createdAt   DateTime @default(now()) @map("created_at")
  @@index([pageId, createdAt])
  @@index([actionType, status])
  @@map("automation_logs")
}

model PageStats {
  pageId          String   @map("page_id")
  date            DateTime @db.Date
  commentsTotal   Int      @default(0) @map("comments_total")
  repliesSent     Int      @default(0) @map("replies_sent")
  messagesSent    Int      @default(0) @map("messages_sent")
  reactionsTotal  Int      @default(0) @map("reactions_total")
  failedJobs      Int      @default(0) @map("failed_jobs")
  page            FacebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  @@id([pageId, date])
  @@map("page_stats")
}

model SystemConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("system_config")
}
